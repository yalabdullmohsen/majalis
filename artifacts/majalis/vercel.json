{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "corepack enable && cd ../.. && corepack pnpm install --frozen-lockfile --prod=false",
  "buildCommand": "pnpm run build",
  "outputDirectory": "dist",
  "proxy": {
    "entrypoint": "middleware.js",
    "matcher": ["/lessons", "/admin", "/admin/:path*", "/dashboard", "/dashboard/:path*"]
  },
  "git": {
    "deploymentEnabled": {
      "*": false,
      "main": true
    }
  },
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "includeFiles": "{lib/**,supabase/**,data/**,src/data/universities-catalog.json,dist/index.html}"
    },
    "api/lessons/[id].js": {
      "maxDuration": 60,
      "includeFiles": "{lib/**,supabase/**,data/**,scripts/lessons-seed.snapshot.json,dist/index.html}"
    }
  },
