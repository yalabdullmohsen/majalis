{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "corepack enable && cd ../.. && corepack pnpm install --frozen-lockfile --prod=false",
  "buildCommand": "pnpm run build",
  "outputDirectory": "dist",
  "git": {
    "deploymentEnabled": {
      "*": false,
      "main": true
    }
  },
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "includeFiles": "{lib/**,supabase/**,data/**,src/data/universities-catalog.json,public/data/rulings-encyclopedia/**,dist/index.html}"
    }
  },
  "crons": [
    {
      "path": "/api/cron/process-import-jobs",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/sync-data",
