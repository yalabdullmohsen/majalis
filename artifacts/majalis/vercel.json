{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "regions": [
    "fra1"
  ],
  "installCommand": "corepack enable && cd ../.. && corepack pnpm install --frozen-lockfile --prod=false",
  "buildCommand": "pnpm run build",
  "outputDirectory": "dist",
  "proxy": {
    "entrypoint": "middleware.js",
    "matcher": [
      "/lessons",
      "/admin",
      "/admin/:path*",
      "/dashboard",
      "/dashboard/:path*",
      "/scholars",
      "/scholars/:path*"
    ]
  },
  "git": {
    "deploymentEnabled": {
      "*": false,
      "main": true
    }
  },
