[{"id":"seed-qa-1596","question":"من أكثر الصحابة رواية للحديث؟","answer":"الجواب: أبو هريرة؛ وهذا ثابت في سيرة الصحابة رضي الله عنهم وفي كتب السيرة والتراجم المعتمدة.","category_id":"seed-cat-sahabah","ruling_type":"معلوم","evidence":"","reference":"","status":"published","review_status":"approved","created_at":"2024-05-12T15:00:00.000Z","qa_categories":{"name":"الصحابة","slug":"sahabah"},"trust_level":"scholarly_source","editorial_review_status":"unreviewed","last_updated_at":"2026-07-27T00:00:00.000Z"},{"id":"seed-qa-1630","question":"من أول الخلفاء الراشدين؟","answer":"الجواب: أبو بكر الصديق؛ وهو أول من تولّى الخلافة بعد وفاة النبي ﷺ بإجماع أهل السنة والجماعة.","category_id":"seed-cat-sahabah","ruling_type":"معلوم","evidence":"","reference":"","status":"published","review_status":"approved","created_at":"2024-05-12T15:00:00.000Z","qa_categories":{"name":"الصحابة","slug":"sahabah"},"trust_level":"scholarly_source","editorial_review_status":"unreviewed","last_updated_at":"2026-07-27T00:00:00.000Z"},{"id":"seed-qa-1631","question":"من ثاني الخلفاء الراشدين؟","answer":"الجواب: عمر بن الخطاب؛ وهو ثاني الخلفاء الراشدين، واشتهر بالعدل والشورى والقضاء رضي الله عنه.","category_id":"seed-cat-sahabah","ruling_type":"معلوم","evidence":"","reference":"","status":"published","review_status":"approved","created_at":"2024-05-12T15:00:00.000Z","qa_categories":{"name":"الصحابة","slug":"sahabah"},"trust_level":"scholarly_source","editorial_review_status":"unreviewed","last_updated_at":"2026-07-27T00:00:00.000Z"},{"id":"seed-qa-1632","question":"من ثالث الخلفاء الراشدين؟","answer":"الجواب: عثمان بن عفان؛ وهذا ثابت في سيرة الصحابة رضي الله عنهم وفي كتب السيرة والتراجم المعتمدة.","category_id":"seed-cat-sahabah","ruling_type":"معلوم","evidence":"","reference":"","status":"published","review_status":"approved","created_at":"2024-05-12T15:00:00.000Z","qa_categories":{"name":"الصحابة","slug":"sahabah"},"trust_level":"scholarly_source","editorial_review_status":"unreviewed","last_updated_at":"2026-07-27T00:00:00.000Z"},{"id":"seed-qa-1633","question":"من رابع الخلفاء الراشدين؟","answer":"الجواب: علي بن أبي طالب؛ وهو رابع الخلفاء الراشدين وابن عمّ النبي ﷺ وزوج ابنته رضي الله عنهما.","category_id":"seed-cat-sahabah","ruling_type":"معلوم","evidence":"","reference":"","status":"published","review_status":"approved","created_at":"2024-05-12T15:00:00.000Z","qa_categories":{"name":"الصحابة","slug":"sahabah"},"trust_level":"scholarly_source","editorial_review_status":"unreviewed","last_updated_at":"2026-07-27T00:00:00.000Z"},{"id":"seed-qa-1634","question":"من الصحابي الملقب بذي النورين؟","answer":"الجواب: عثمان بن عفان؛ وهذا ثابت في سيرة الصحابة رضي الله عنهم وفي كتب السيرة والتراجم المعتمدة.","category_id":"seed-cat-sahabah","ruling_type":"معلوم","evidence":"","reference":"","status":"published","review_status":"approved","created_at":"2024-05-12T15:00:00.000Z","qa_categories":{"name":"الصحابة","slug":"sahabah"},"trust_level":"scholarly_source","editorial_review_status":"unreviewed","last_updated_at":"2026-07-27T00:00:00.000Z"},{"id":"seed-qa-1635","question":"من الصحابي الملقب بالفاروق؟","answer":"الجواب: عمر بن الخطاب؛ وهذا ثابت في سيرة الصحابة رضي الله عنهم وفي كتب السيرة والتراجم المعتمدة.","category_id":"seed-cat-sahabah","ruling_type":"معلوم","evidence":"","reference":"","status":"published","review_status":"approved","created_at":"2024-05-12T15:00:00.000Z","qa_categories":{"name":"الصحابة","slug":"sahabah"},"trust_level":"scholarly_source","editorial_review_status":"unreviewed","last_updated_at":"2026-07-27T00:00:00.000Z"},{"id":"seed-qa-1636","question":"من أكثر الصحابة رواية للحديث؟","answer":"الجواب: أبو هريرة؛ وهذا ثابت في سيرة الصحابة رضي الله عنهم وفي كتب السيرة والتراجم المعتمدة.","category_id":"seed-cat-sahabah","ruling_type":"معلوم","evidence":"","reference":"","status":"published","review_status":"approved","created_at":"2024-05-12T15:00:00.000Z","qa_categories":{"name":"الصحابة","slug":"sahabah"},"trust_level":"scholarly_source","editor