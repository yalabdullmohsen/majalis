// Debug overrides — copy secrets locally; never commit real keys.
// Release builds inject values via CI xcconfig / Xcode Cloud / Fastlane env.
// Xcode xcconfig: use https:/$()/host to emit https://host

SUPABASE_URL = https:/$()/example.supabase.co
SUPABASE_ANON_KEY =
VERCEL_API_BASE_URL = https:/$()/example.com
APP_ENVIRONMENT = debug
